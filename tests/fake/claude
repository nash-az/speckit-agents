#!/usr/bin/env python3
"""A stand-in for `claude -p` in the supervisor tests: plays one scripted cycle per invocation.

$FAKE_DIR/scenario.json: {"cycles": [[step, ...], ...]}. Steps: {"emit": event},
{"journal": event}, {"transcript": true}, {"sleep": seconds}, {"exit": code}.
Each invocation appends its arguments to $FAKE_DIR/calls and writes its environment to $FAKE_DIR/env<n>.json.
{"transcript": "<name>"} launches another workflow in $FAKE_DIR/<name>; later journal steps go there.
{"control": request} writes a dashboard request to $FAKE_CONTROL (the supervisor's control.json), atomically.
{"tick": "T001"} changes `- [ ] T001` to `- [x] T001` in the file named by $FAKE_TASKS.
{"finish": true} removes .sdd/run.json in the project (the current directory), as a finished run does.
{"run": "<run id>"} writes .sdd/run.json in the project with that `run_id`, as a starting run does.
{"write": {"path": "<relative path>", "text": "..."}} writes a file in the project, as an implementer does.
{"commit": "<message>"} commits everything in the project's tree (`git add -A`), as the bookkeeper does.
"""
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

d = Path(os.environ["FAKE_DIR"])
count_file = d / "count"
n = int(count_file.read_text()) if count_file.exists() else 0
count_file.write_text(str(n + 1))
(d / f"pid{n}").write_text(str(os.getpid()))
with (d / "calls").open("a") as f:
    f.write(json.dumps(sys.argv[1:]) + "\n")
(d / f"env{n}.json").write_text(json.dumps(dict(os.environ)))
steps = json.loads((d / "scenario.json").read_text())["cycles"][n]
wf = d / "wf"
wf.mkdir(exist_ok=True)
for step in steps:
    if "emit" in step:
        print(json.dumps(step["emit"]), flush=True)
    elif "journal" in step:
        with (wf / "journal.jsonl").open("a") as j:
            j.write(json.dumps(step["journal"]) + "\n")
    elif "transcript" in step:
        if isinstance(step["transcript"], str):
            wf = d / step["transcript"]
            wf.mkdir(exist_ok=True)
        text = f"Workflow launched in background. Task ID: x\nTranscript dir: {wf}\nRun ID: wf_x"
        print(json.dumps({"type": "user", "message": {"content": [{"type": "tool_result", "content": text}]}}), flush=True)
    elif "control" in step:
        target = Path(os.environ["FAKE_CONTROL"])
        tmp = target.with_name("control.json.tmp")
        tmp.write_text(json.dumps(step["control"]))
        os.replace(tmp, target)
    elif "tick" in step:
        tasks = Path(os.environ["FAKE_TASKS"])
        tid = step["tick"]
        tasks.write_text(re.sub(rf"^(\s*- )\[ \]( {re.escape(tid)}\b)", r"\1[x]\2",
                                tasks.read_text(), count=1, flags=re.M))
    elif "run" in step:
        (Path.cwd() / ".sdd" / "run.json").write_text(json.dumps({"run_id": step["run"]}))
    elif "write" in step:
        target = Path.cwd() / step["write"]["path"]
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(step["write"]["text"])
    elif "commit" in step:
        subprocess.run(["git", "add", "-A"], check=True, capture_output=True)
        subprocess.run(["git", "-c", "user.name=fake", "-c", "user.email=fake@example.com", "-c",
                        "commit.gpgsign=false", "commit", "-q", "-m", step["commit"]], check=True, capture_output=True)
    elif "finish" in step:
        (Path.cwd() / ".sdd" / "run.json").unlink(missing_ok=True)
    elif "sleep" in step:
        time.sleep(step["sleep"])
    elif "exit" in step:
        sys.exit(step["exit"])
